// Factory preset library, part 3: helpers for the third set of presets (PresetLibrary3.inc, generated by
// scripts/presets3/gen.py). Included by Presets.cpp inside its anonymous namespace after the other libraries.

// A frame of a wavetable family (frame 1..16); see Wavetables.cpp.
enum Family : int {
    PulseWidthF, SawBrightF, SquareToSawF, HarmonicBuildF, FormantSweepF, VowelMorphF, FmIndexF, FmOctaveF, HardSyncF,
    WavefoldF, TubeDriveF, PhaseBendF, ResonantSweepF, CrusherF, CombSweepF, OrganStopsF, SpectraF
};
constexpr int fam(Family f, int frame) { return WavetableBank::kFamilyWaveFirst + static_cast<int>(f) * WavetableBank::kFramesPerFamily + frame - 1; }

// Osc on a family's frame 1 that Wave Scan sweeps across the whole family (scan 0..1 = frames 1..16).
OscParams& famOsc(Patch& p, int number, Family f, float ratio, float level, float scanPos = 0.0f)
{
    OscParams& o = osc(p, number, fam(f, 1), ratio, level);
    scan(o, scanPos, WavetableBank::kFramesPerFamily - 1);
    return o;
}

// Carrier plus a decaying modulator (the modulator's own envelope sets the FM index over time).
OscParams& fmPair(Patch& p, int carrier, int wave, float ratio, float level, int modWave, float modRatio, float depth, float decayMs,
                  float vel = 0.6f)
{
    OscParams& c = osc(p, carrier, wave, ratio, level);
    strike(p, carrier + 1, modWave, modRatio, depth, decayMs, vel);
    return c;
}

// A steady modulator (constant index, no envelope).
OscParams& modOsc(Patch& p, int number, int wave, float ratio, float depth) { return osc(p, number, wave, ratio, depth); }

void amp(Patch& p, float a, float d, float s, float r) { adsr(p.env[2], a, d, s, r); }

// Analog filter (Env 2) with an envelope sweep.
void analogLp(Patch& p, float hz, float res, float envAmt = 0.0f, float a = 1.0f, float d = 400.0f, float s = 0.0f, float r = 300.0f)
{
    p.afilt.cutoff = cutoff(hz);
    p.afilt.resonance = res;
    p.afilt.envAmt = envAmt;
    adsr(p.env[1], a, d, s, r);
}

// Digital filter (Env 1).
void digital(Patch& p, DigitalFilterType type, float hz, float res, float envAmt = 0.0f, float a = 1.0f, float d = 400.0f,
             float s = 0.0f, float r = 300.0f)
{
    p.dfilt.type = type;
    p.dfilt.cutoff = cutoff(hz);
    p.dfilt.resonance = res;
    p.dfilt.envAmt = envAmt;
    adsr(p.env[0], a, d, s, r);
}

// LFO n (1-5) setup; returns it for further tweaks.
LfoParams& lfo(Patch& p, int n, LfoWave wave, float rateHz, LfoTrig trig = LfoTrig::Poly)
{
    LfoParams& l = p.lfo[static_cast<size_t>(n - 1)];
    l.wave = wave;
    l.rateHz = rateHz;
    l.trig = trig;
    return l;
}

LfoParams& syncLfo(Patch& p, int n, LfoWave wave, const char* div, LfoTrig trig = LfoTrig::Poly)
{
    LfoParams& l = lfo(p, n, wave, 1.0f, trig);
    l.bpmSync = true;
    l.syncDiv = syncDiv(div);
    return l;
}

int lfoSrc(int n) { return src::Lfo1 + n - 1; }
int lfoUni(int n) { return src::Lfo1Uni + n - 1; }
int envSrc(int n) { return src::Env1 + n - 1; }
int oscScan(int number) { return dst::OscScanBase + number - 1; }
int oscFine(int number) { return dst::osc(number - 1, dst::OscFine); }
int oscPitch(int number) { return dst::osc(number - 1, dst::OscPitch); }

void wheel(Patch& p, int dest, float depth) { route(p, src::ModWheel, dest, depth); }

void unison(Patch& p, int density, float detune, PolyMode mode = PolyMode::UnisonPoly)
{
    p.voice.polyMode = mode;
    p.voice.density = density;
    p.voice.unisonDetune = detune;
}

void stereoOscs(Patch& p, float detuneCents, OscPanTarget target = OscPanTarget::Carriers)
{
    p.voice.oscStereo = true;
    p.voice.oscPanTarget = target;
    p.voice.carrierDetune = detuneCents;
}

void preFx(Patch& p, FxType type) { p.fx.pre.type = type; }
void postFx(Patch& p, FxType type) { p.fx.post.type = type; }

void distort(Patch& p, float drive, float tone, float mix = 1.0f, bool pre = true)
{
    InsertFxParams& s = pre ? p.fx.pre : p.fx.post;
    s.type = FxType::Distort;
    s.distort.drive = drive;
    s.distort.tone = tone;
    s.distort.mix = mix;
}

