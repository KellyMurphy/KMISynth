void compress(Patch& p, float ratio, float thresholdDb, float makeupDb = 0.0f, CompSidechain sc = CompSidechain::Off)
{
    p.fx.post.type = FxType::Compressor;
    p.fx.post.comp.ratio = ratio;
    p.fx.post.comp.thresholdDb = thresholdDb;
    p.fx.post.comp.makeupDb = makeupDb;
    p.fx.post.comp.sidechain = sc;
