void eq(Patch& p, float lowDb, float midDb, float highDb, bool pre = false)
{
    InsertFxParams& s = pre ? p.fx.pre : p.fx.post;
    s.type = FxType::Eq;
    s.eq.lowDb = lowDb;
    s.eq.midDb = midDb;
    s.eq.highDb = highDb;
}

// The step sequencer, started and transposed by the held key (notes are written around middle C).
void keySeq(Patch& p, int length, const char* div)
{
    p.seq.enabled = true;
    p.seq.trigger = SeqTrigger::Key;
    p.seq.track[0].length = length;
    p.seq.track[0].syncDiv = syncDiv(div);
    p.seq.track[1].enabled = false;
    p.seq.track[2].enabled = false;
}

// Writes a pattern onto a note track: one entry per step, -1 = rest, otherwise the MIDI note.
void seqPattern(Patch& p, int track, std::initializer_list<int> notes, int velocity = 100, int lengthQuarters = 3)
{
    int i = 0;
    for (int n : notes)
    {
        SeqStep& s = p.seqData.steps[static_cast<size_t>(track)][static_cast<size_t>(i++)];
        if (n < 0) continue;
        s.count = 1;
        s.notes[0] = { static_cast<uint8_t>(n), static_cast<uint8_t>(velocity), static_cast<uint8_t>(lengthQuarters) };
    }
}

// Accent / ratchet / probability on one step of a note track.
SeqStep& seqStep(Patch& p, int track, int step) { return p.seqData.steps[static_cast<size_t>(track)][static_cast<size_t>(step)]; }

// A macro lane of the sequencer's macro track (values 0..1 per step).
void seqLane(Patch& p, int lane, std::initializer_list<float> values, int length, const char* div)
{
    p.seq.track[2].enabled = true;
    p.seq.track[2].length = length;
    p.seq.track[2].syncDiv = syncDiv(div);
    p.seqData.laneOn[static_cast<size_t>(lane - 1)] = true;
    int i = 0;
    for (float v : values) p.seqData.lanes[static_cast<size_t>(lane - 1)][static_cast<size_t>(i++)] = v;
}

// Extra loudness for presets that reach the patch-level ceiling (set by scripts/presets3/level.py): first the
// oscillators' level into the filter, then the carriers' levels, each capped at full scale.
void boostCarriers(Patch& p, float factor)
{
    const float oscs = std::fmin(1.0f, p.vca.oscsLevel * factor);
    factor *= p.vca.oscsLevel / oscs;
    p.vca.oscsLevel = oscs;
    if (factor <= 1.0f || p.algo.mode != AlgoMode::Single) return;
    const Algorithm& a = presetAlgorithm(p.algo.index);
    for (int i = 0; i < kNumOscs; ++i)
    {
        OscParams& o = p.osc[static_cast<size_t>(i)];
        if (o.mute || !a.isCarrier(i)) continue;
        o.initLevel = std::fmin(1.0f, o.initLevel * factor);
        o.envLevel = std::fmax(-1.0f, std::fmin(1.0f, o.envLevel * factor));
    }
}
